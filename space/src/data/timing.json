    }
   ],
   "cues": [
    {
     "start": 0.5,
     "end": 4.888,
     "text": "A mountain, a storm, a hexagon, a sugar cube,",
     "para": 0
    },
    {
     "start": 4.888,
     "end": 9.388,
     "text": "a flash, a shadow, and a speck of ancient light.",
     "para": 0
    },
    {
     "start": 9.388,
     "end": 11.98,
     "text": "Every single one is real.",
     "para": 0
    },
    {
     "start": 11.98,
     "end": 13.753,
     "text": "Which one surprised you the most?",
     "para": 1
    },
    {
     "start": 13.753,
     "end": 15.099,
     "text": "Tell us in the comments.",
     "para": 1
    },
    {
     "start": 15.099,
     "end": 18.49,
     "text": "And if you want more of the universe at its most extreme,",
     "para": 1
    },
    {
     "start": 18.49,
     "end": 19.409,
     "text": "you know what to do.",
     "para": 1
    }
   ]
  }
 ],
 "totalFrames": 9423
}