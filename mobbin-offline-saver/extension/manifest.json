{
  "manifest_version": 3,
  "name": "Mobbin Offline Saver",
  "version": "1.0.0",
  "description": "Save a Mobbin app's flows as one HTML file with sliders that works without internet.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["https://mobbin.com/*", "https://*.mobbin.com/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Save this Mobbin page for offline",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save this Mobbin page for offline"
    }
  }
}
