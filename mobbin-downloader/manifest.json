{
  "manifest_version": 3,
  "name": "Mobbin Screen Downloader",
  "version": "1.0",
  "description": "Download every phone screen on a Mobbin flows page, in order.",
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["https://mobbin.com/*", "https://*.mobbin.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "Download Mobbin screens" }
}
